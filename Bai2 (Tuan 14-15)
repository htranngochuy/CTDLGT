
#include <iostream>


struct Node {
    int data;
    Node* left;
    Node* right;
};

Node* tao_node(int x) {
    Node* p = new Node;
    p->data = x;
    p->left = NULL;
    p->right = NULL;
    return p;
}

void them_trai(Node*& t, int x) {
    if (t == NULL || t->left != NULL) {
        std::cout << "Khong them duoc\n";
    }
    else {
        t->left = tao_node(x);
    }
}
void them_phai(Node*& t, int x) {
    if (t == NULL || t->right != NULL) {
        std::cout << "Khong them duoc\n";
    }
    else {
        t->right = tao_node(x);
    }
}

void duyet_truoc(Node* t) {
    if (t != NULL) {
        std::cout << t->data << " ";
        duyet_truoc(t->left);
        duyet_truoc(t->right);
    }
}

bool so_sanh_cay(Node* t, Node* h) {
    if (t == NULL && h == NULL) {
        return true;
    }
    return (t->data == h->data && so_sanh_cay(t->left, h->left) && so_sanh_cay(t->right, h->right));
}
int main()
{
    Node* p = new Node();
    Node* l = new Node();
    if (so_sanh_cay(p, l))
        std::cout << "2 cay giong nhau\n";
    else std::cout << "2 cay khac nhau\n";
    p->data = 5; 
    l->data = 4;
    if (so_sanh_cay(p, l))
        std::cout << "2 cay giong nhau\n";
    else std::cout << "2 cay khac nhau\n";
    return 0;

}
